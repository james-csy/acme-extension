{
  "manifest_version": 3,
  "name": "LinkedIn Connect Note",
  "version": "0.10.0",
  "description": "Fills your saved templates into LinkedIn's connection note and message boxes.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/core/namespace.js",
        "src/core/types.js",
        "src/core/template.js",
        "src/core/names.js",
        "src/core/people.js",
        "src/core/fill.js",
        "src/core/storage.js",
        "src/core/focus.js",
        "src/core/watch.js",
        "src/core/capture.js",
        "src/panel/panel.js",
        "src/adapters/connect-note.js",
        "src/adapters/messaging.js",
        "src/adapters/sales-nav.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": [
        "https://www.linkedin.com/tscp-serving/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
